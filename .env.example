# Copy this file to ".env" and paste your two FREE tokens (no credit card for either).

# 1) Travelpayouts (radar): https://www.travelpayouts.com  ->  Profile -> API token
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here

# 2) SerpApi (confirmer): https://serpapi.com  ->  dashboard shows your API key
SERPAPI_KEY=your_serpapi_key_here
